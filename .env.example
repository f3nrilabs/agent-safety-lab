# Copy to .env and fill in only what you use. Keys are read from environment
# variables only; .env is gitignored and is loaded by the harness if present.

# Anthropic Messages API
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint (OpenAI, DeepSeek, GLM, ...).
# For DeepSeek: https://api.deepseek.com  For GLM: your provider's URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=
